+  # The same tests on Postgres instead of SQLite (tests/conftest.py reads TEST_DATABASE_URL).
+  # SQLite hides Postgres-only behaviour: NUMERIC scale, enum types, constraint and type errors.
+  backend-postgres:
+    name: backend-postgres
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    defaults:
+      run:
+        working-directory: backend
+    services:
+      postgres:
+        image: postgres:18.6-alpine  # same as docker-compose.yml
+        env:
+          POSTGRES_USER: fund
+          POSTGRES_PASSWORD: fund
+          POSTGRES_DB: fund_test
+        ports:
+          - 5432:5432
+        options: >-
+          --health-cmd "pg_isready -U fund -d fund_test"
+          --health-interval 2s --health-timeout 5s --health-retries 20
+    env:
+      TEST_DATABASE_URL: postgresql+psycopg://fund:fund@127.0.0.1:5432/fund_test
+      LLM_API_KEY: ""
+      LLM_MODEL: ""
+    steps:
+      - uses: actions/checkout@v7
+
+      - uses: astral-sh/setup-uv@v10.2.0
+        with:
+          working-directory: backend
+          enable-cache: true
+          cache-dependency-glob: uv.lock  # relative to working-directory
+
+      - name: Install dependencies
+        run: uv sync --locked
+
+      - name: Pytest on Postgres
+        run: uv run pytest
+
   frontend:
     name: frontend
     runs-on: ubuntu-latest
