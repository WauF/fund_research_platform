+      # A real KAP report through the whole path on the running stack: PDF -> SeaweedFS ->
+      # documents -> baseline extraction -> validation -> holdings (FTD) -> API. Run twice: the
+      # second run must not add anything (reprocessing creates 0 duplicate holdings).
+      - uses: astral-sh/setup-uv@v10.2.0
+        with:
+          working-directory: backend
+          enable-cache: true
+          cache-dependency-glob: uv.lock  # relative to working-directory
+
+      - name: Extraction smoke test
+        working-directory: backend
+        run: |
+          uv sync --locked
+          uv run python -m scripts.ingest_corpus IRF | tee "$RUNNER_TEMP/ingest.txt"
+          grep -Eq '^IRF +saved +document [0-9]+, 23 rows, ok$' "$RUNNER_TEMP/ingest.txt"
+          id=$(sed -nE 's/^IRF +saved +document ([0-9]+),.*/\1/p' "$RUNNER_TEMP/ingest.txt")
+          curl -fsS "http://localhost:8000/documents/$id/holdings" > "$RUNNER_TEMP/holdings.json"
+          h="$RUNNER_TEMP/holdings.json"
+          [ "$(jq '.holdings | length' "$h")" = 23 ]
+          [ "$(jq -r '.run.status' "$h")" = ok ]
+          [ "$(jq -r '[.holdings[].weight_basis] | unique | join(",")' "$h")" = total ]
+          [ "$(jq -r '.holdings[] | select(.held_fund_code == "BGP") | .weight' "$h")" = 0.1059 ]
+          uv run python -m scripts.ingest_corpus IRF | grep -Eq '^IRF +skipped'
+
       # Every downgrade() must work on real Postgres too (SQLite misses e.g. leftover enum types).
