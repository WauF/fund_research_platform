# Copy to .env and fill in. Never commit .env.

# --- Deployment ---
# Image tag docker compose runs: "dev" = built locally; e.g. v0.1.0 = a released build from ghcr.io.
APP_VERSION=dev

# --- PostgreSQL ---
# POSTGRES_HOST/PORT are for running the backend on your machine; inside docker compose the
# api service always uses postgres:5432 (see docker-compose.yml).
POSTGRES_USER=fund
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fund_platform
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Object storage for PDFs (SeaweedFS, S3-compatible) ---
# The key pair is also the SeaweedFS admin UI login. Inside docker compose the api service always
# uses http://seaweedfs:8333 (see docker-compose.yml).
S3_ACCESS_KEY=fund
S3_SECRET_KEY=change-me-too
S3_ENDPOINT_URL=http://localhost:8333
S3_BUCKET=documents

# --- LLM (see docs/decisions for provider/model choice) ---
LLM_API_KEY=
LLM_MODEL=

# --- Market/return data (only used by backend/evaluations/, never by routine tests) ---
MARKET_DATA_API_KEY=
