# Copy to .env and fill in. Never commit .env.

# --- PostgreSQL ---
POSTGRES_USER=fund
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fund_platform
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- MinIO (S3-compatible object storage for PDFs) ---
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-too
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=documents

# --- LLM (see docs/decisions for provider/model choice) ---
LLM_API_KEY=
LLM_MODEL=

# --- Market/return data (only used by backend/evaluations/, never by routine tests) ---
MARKET_DATA_API_KEY=
