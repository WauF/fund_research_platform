# --- Secrets ---
.env
.env.*
!.env.example

# --- Raw data: KAP PDFs live only in data/raw/ (docs/decisions/0007); no PDFs anywhere else ---
*.pdf
!data/raw/**/*.pdf

# --- Python ---
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/

# --- Node (frontend/ has its own .gitignore too) ---
node_modules/

# --- Local docker volumes ---
.docker-data/

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# --- Evaluation outputs (uploaded as CI artifacts, not committed) ---
backend/evaluations/results/
